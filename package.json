{
  "name": "portaldelojas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pages:dev": "wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply LOJAS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply LOJAS_DB --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "primeflex": "3.3.1",
    "primeicons": "latest",
    "primereact": "^10.9.9",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sass": "^1.108.2",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
